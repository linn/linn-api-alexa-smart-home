{
  "name": "linn-api-alexa-smart-home",
  "version": "1.0.0",
  "description": "Alexa Smart Home skill backend for Linn devices",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "jwt-decode": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^24.13.4",
    "nock": "^14.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --project unit",
    "test:acceptance": "vitest run --project acceptance",
    "test:all": "npm run typecheck && vitest run",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  }
